<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="sportprofiles.Views.Account.ConfirmResetPwdPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="">
    <VerticalStackLayout>
        <StackLayout Padding="0,13,0,0">
            <Image
                x:Name="imgLogo"
                HeightRequest="40"
                HorizontalOptions="Center"
                Source="logo100.jpg"
                VerticalOptions="Center"
                WidthRequest="160" />

            <Label
                x:Name="lblAppName"
                Padding="30,5,30,5"
                FontAttributes="Bold"
                FontSize="18"
                HorizontalTextAlignment="Center"
                Text="Password Reset Confirmatipon"
                TextColor="{StaticResource Gray900}" />

            <Label
                x:Name="lblInstruction"
                Padding="20,5,20,5"
                FontAttributes="None"
                FontSize="15"
                HorizontalTextAlignment="Center"
                Text="Your password has been successfully reset."
                TextColor="{StaticResource Gray600}" />

            <Label
                x:Name="ReturnToLogin"
                Padding="30,10,30,10"
                FontAttributes="Bold"
                FontSize="17"
                HorizontalOptions="CenterAndExpand"
                Text="Tap here to Login"
                TextColor="Blue">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="Login_confirm_tap_Tapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label Text="" />
        </StackLayout>
    </VerticalStackLayout>
</ContentPage>
