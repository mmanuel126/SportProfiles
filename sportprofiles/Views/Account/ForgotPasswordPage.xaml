<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="sportprofiles.Views.Account.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=" ">

    <VerticalStackLayout>

        <StackLayout Padding="0,13,0,0">

            <Image
                x:Name="imgLogo"
                HeightRequest="40"
                HorizontalOptions="Center"
                Source="logo.jpg"
                VerticalOptions="Center"
                WidthRequest="160" />

            <Label
                x:Name="lblPageHeader"
                Padding="30,5,30,5"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalTextAlignment="Center"
                Text="Forgot Password"
                TextColor="{StaticResource Gray900}" />

            <Label
                x:Name="lblInstruction"
                Padding="20,15,20,5"
                FontAttributes="None"
                FontSize="15"
                HorizontalTextAlignment="Center"
                Text="Forgot your password? Enter your email below to recover it."
                TextColor="{StaticResource Gray600}" />

            <StackLayout
                Grid.Row="2"
                HorizontalOptions="Center"
                Spacing="15"
                VerticalOptions="Fill">

                <StackLayout HorizontalOptions="Center" Spacing="1">
                    <Entry
                        x:Name="EmailText"
                        Keyboard="Email"
                        Placeholder="Email..."
                        PlaceholderColor="{StaticResource Gray500}"
                        WidthRequest="300" />
                </StackLayout>

                <StackLayout>
                    <Button
                        x:Name="ResetPwd"
                        BackgroundColor="{StaticResource Blue100Accent}"
                        BorderColor="Black"
                        Clicked="ForgotPwdButton_Clicked"
                        CornerRadius="20"
                        FlexLayout.AlignSelf="Stretch"
                        FontAttributes="Bold"
                        FontSize="Medium"
                        HorizontalOptions="CenterAndExpand"
                        Text="Reset Password"
                        TextColor="White"
                        WidthRequest="300" />
                </StackLayout>

            </StackLayout>
            <Label
                x:Name="RememberLoginLabel"
                Padding="20,20,20,5"
                FontAttributes="Bold"
                FontSize="17"
                HorizontalTextAlignment="Center"
                Text="Sign in to Existing Account"
                TextColor="Blue"
                WidthRequest="300">
                <Label.GestureRecognizers>

                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="Login_tap_Tapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Text="" />

        </StackLayout>

    </VerticalStackLayout>
</ContentPage>