<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="sportprofiles.Views.Account.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=" ">
    <VerticalStackLayout>

        <StackLayout Padding="0,13,0,0">
            <Image
                x:Name="imgLogo"
                HeightRequest="40"
                HorizontalOptions="Center"
                Source="logo100.jpg"
                VerticalOptions="Center"
                WidthRequest="160" />

            <Label
                x:Name="lblAppName"
                Padding="30,5,30,5"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalTextAlignment="Center"
                Text="Change Password"
                TextColor="{StaticResource Gray900}" />

            <Label
                x:Name="lblInstruction1"
                Padding="10,5,10,5"
                FontAttributes="None"
                FontSize="15"
                HorizontalTextAlignment="Start"
                Text=""
                TextColor="{StaticResource Gray600}" />

            <Label
                x:Name="lblInstruction2"
                Padding="10,5,10,5"
                FontAttributes="None"
                FontSize="15"
                HorizontalTextAlignment="Start"
                Text=""
                TextColor="{StaticResource Gray600}" />


            <StackLayout
                Padding="10,0,0,0"
                HorizontalOptions="Start"
                Spacing="1">
                <Entry
                    x:Name="Pwd"
                    IsPassword="True"
                    IsTextPredictionEnabled="False"
                    Keyboard="Text"
                    Placeholder="Enter new password..."
                    PlaceholderColor="{StaticResource Gray500}"
                    Text=""
                    WidthRequest="300" />
            </StackLayout>

            <StackLayout
                Padding="10,0,0,0"
                HorizontalOptions="Start"
                Spacing="1">
                <Entry
                    x:Name="PwdReEntered"
                    IsPassword="True"
                    Placeholder="Enter new password again..."
                    PlaceholderColor="{StaticResource Gray500}"
                    Text=""
                    WidthRequest="300" />
            </StackLayout>

            <StackLayout>
                <Button
                    x:Name="ChangePwd"
                    BackgroundColor="{StaticResource Blue100Accent}"
                    BorderColor="Black"
                    Clicked="ChangePwdButton_Clicked"
                    CornerRadius="20"
                    FlexLayout.AlignSelf="Stretch"
                    FontAttributes="Bold"
                    FontSize="Medium"
                    HorizontalOptions="CenterAndExpand"
                    Text="Change Password"
                    TextColor="White"
                    WidthRequest="300" />
            </StackLayout>

        </StackLayout>

    </VerticalStackLayout>
</ContentPage>
