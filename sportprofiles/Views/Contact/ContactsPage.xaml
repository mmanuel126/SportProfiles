<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="sportprofiles.Views.Contact.ContactsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sfToolkit="http://schemas.syncfusion.com/maui/toolkit"
    Title="Contacts">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary Source="ContactResourceDictionary.xaml" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>

        <sfToolkit:SfTabView
            x:Name="tabView"
            BackgroundColor="#E4E4E4"
            IndicatorBackground="Red">
            <sfToolkit:SfTabView.Items>

                <sfToolkit:SfTabItem Header="My Contacts">

                    <sfToolkit:SfTabItem.Content>

                        <Grid BackgroundColor="WhiteSmoke">

                            <AbsoluteLayout>
                                <ScrollView>
                                    <StackLayout AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">

                                        <CollectionView
                                            x:Name="collectionView"
                                            ItemsSource="{Binding Contact}"
                                            SelectionMode="Single">
                                            <CollectionView.EmptyView>
                                                <Label Text="You have no contacts." />
                                            </CollectionView.EmptyView>
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>

                                                    <StackLayout Padding="10,10,10,0" Spacing="8">
                                                        <Frame>
                                                            <StackLayout>
                                                                <StackLayout Padding="0,0,0,10" Style="{StaticResource itemsInsideCardViewStackLayoutStyle}">
                                                                    <Frame Style="{StaticResource profileImageFrameStyle}">
                                                                        <Image
                                                                            Aspect="AspectFill"
                                                                            HeightRequest="88"
                                                                            HorizontalOptions="StartAndExpand"
                                                                            Source="{Binding PicturePath}"
                                                                            Style="{StaticResource profileImageStyle}"
                                                                            VerticalOptions="CenterAndExpand" />
                                                                    </Frame>
                                                                    <StackLayout Style="{StaticResource detailsStackLayout}">
                                                                        <Label Style="{StaticResource NameLabel}" Text="{Binding FriendName}" />
                                                                        <StackLayout Style="{StaticResource imageLableStackLayout}">
                                                                            <Label Style="{StaticResource TitleLabelStyle}" Text="{Binding TitleDesc}" />
                                                                        </StackLayout>
                                                                        <StackLayout Style="{StaticResource imageLableStackLayout}">
                                                                            <Label
                                                                                FontAttributes="Bold"
                                                                                Style="{StaticResource LabelStyle}"
                                                                                Text="Tap here to view profile..."
                                                                                TextColor="Blue">
                                                                                <Label.GestureRecognizers>
                                                                                    <TapGestureRecognizer Buttons="Primary" Tapped="OnTapGestureRecognizerTapped" />
                                                                                </Label.GestureRecognizers>
                                                                            </Label>
                                                                        </StackLayout>
                                                                        <StackLayout Style="{StaticResource imageLableStackLayout}">
                                                                            <Label Style="{StaticResource LabelStyle}" Text="Swipe right to drop contact..." />
                                                                        </StackLayout>
                                                                    </StackLayout>
                                                                </StackLayout>
                                                            </StackLayout>
                                                        </Frame>
                                                    </StackLayout>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>

                                    </StackLayout>
                                </ScrollView>
                            </AbsoluteLayout>

                        </Grid>

                    </sfToolkit:SfTabItem.Content>

                </sfToolkit:SfTabItem>

                <sfToolkit:SfTabItem Header="Requests">
                    <sfToolkit:SfTabItem.Content>
                        <Grid BackgroundColor="WhiteSmoke">
                            <AbsoluteLayout>
                                <StackLayout AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">

                                    <CollectionView
                                        x:Name="conReqView"
                                        ItemsSource="{Binding ContactRequest}"
                                        SelectionMode="Single">

                                        <CollectionView.EmptyView>
                                            <Label Padding="10" Text="You have no contact requests." />
                                        </CollectionView.EmptyView>

                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>

                                                <StackLayout Padding="10,10,10,0" Spacing="8">
                                                    <Frame>
                                                        <StackLayout>
                                                            <StackLayout Padding="0,0,0,10" Style="{StaticResource itemsInsideCardViewStackLayoutStyle}">
                                                                <Frame Style="{StaticResource profileImageFrameStyle}">
                                                                    <Image
                                                                        Aspect="AspectFill"
                                                                        HeightRequest="88"
                                                                        HorizontalOptions="StartAndExpand"
                                                                        Source="{Binding PicturePath}"
                                                                        Style="{StaticResource profileImageStyle}"
                                                                        VerticalOptions="CenterAndExpand" />
                                                                </Frame>
                                                                <StackLayout Style="{StaticResource detailsStackLayout}">
                                                                    <Label Style="{StaticResource NameLabel}" Text="{Binding FriendName}" />
                                                                    <StackLayout Style="{StaticResource imageLableStackLayout}">
                                                                        <Label Style="{StaticResource TitleLabelStyle}" Text="{Binding TitleDesc}" />
                                                                    </StackLayout>
                                                                    <StackLayout Style="{StaticResource imageLableStackLayout}">
                                                                        <Label
                                                                            FontAttributes="Bold"
                                                                            Style="{StaticResource LabelStyle}"
                                                                            Text="Tap here to view profile..."
                                                                            TextColor="Blue">
                                                                            <Label.GestureRecognizers>
                                                                                <TapGestureRecognizer
                                                                                    Buttons="Secondary"
                                                                                    CommandParameter="{Binding .}"
                                                                                    Tapped="OnTapGestureRecognizerTapped" />
                                                                            </Label.GestureRecognizers>
                                                                        </Label>
                                                                    </StackLayout>
                                                                    <StackLayout Style="{StaticResource imageLableStackLayout}">
                                                                        <Label Style="{StaticResource LabelStyle}" Text="Swipe right to drop contact..." />
                                                                    </StackLayout>
                                                                </StackLayout>
                                                            </StackLayout>
                                                        </StackLayout>
                                                    </Frame>
                                                </StackLayout>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </StackLayout>
                            </AbsoluteLayout>
                        </Grid>
                    </sfToolkit:SfTabItem.Content>
                </sfToolkit:SfTabItem>

            </sfToolkit:SfTabView.Items>

        </sfToolkit:SfTabView>

    </ContentPage.Content>

</ContentPage>