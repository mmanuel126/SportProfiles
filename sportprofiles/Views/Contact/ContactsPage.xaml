<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="sportprofiles.Views.Contact.ContactsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sfToolkit="http://schemas.syncfusion.com/maui/toolkit"
    Title="Contacts">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            x:Name="refreshContacts"
            Command="{Binding RefreshCommand}"
            IconImageSource="refresh.png" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary Source="ContactResourceDictionary.xaml" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>

        <sfToolkit:SfTabView
            x:Name="tabView"
            BackgroundColor="#E4E4E4"
            IndicatorBackground="Red">
            <sfToolkit:SfTabView.Items>

                <sfToolkit:SfTabItem Header="My Contacts">

                    <sfToolkit:SfTabItem.Content>

                        <Grid BackgroundColor="WhiteSmoke">

                            <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
                                <RefreshView.Content>
                                    <StackLayout>

                                        <CollectionView
                                            x:Name="collectionView"
                                            ItemsSource="{Binding Contact}"
                                            SelectionMode="Single">
                                            <CollectionView.EmptyView>
                                                <Label Text="You have no contacts." />
                                            </CollectionView.EmptyView>
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>

                                                    <SwipeView BackgroundColor="WhiteSmoke">
                                                        <SwipeView.LeftItems>
                                                            <SwipeItems>
                                                                <SwipeItem
                                                                    BackgroundColor="Red"
                                                                    Command="{Binding Source={x:Reference collectionView}, Path=BindingContext.DropCommand}"
                                                                    CommandParameter="{Binding .}"
                                                                    IconImageSource="reject.png"
                                                                    Text="Drop" />
                                                            </SwipeItems>
                                                        </SwipeView.LeftItems>

                                                        <StackLayout Padding="10,10,10,0" Spacing="8">
                                                            <Frame>
                                                                <StackLayout>
                                                                    <StackLayout Padding="0,0,0,10" Style="{StaticResource itemsInsideCardViewStackLayoutStyle}">
                                                                        <Frame Style="{StaticResource profileImageFrameStyle}">
                                                                            <Image
                                                                                Aspect="AspectFill"
                                                                                HeightRequest="88"
                                                                                HorizontalOptions="StartAndExpand"
                                                                                Source="{Binding PicturePath}"
                                                                                Style="{StaticResource profileImageStyle}"
                                                                                VerticalOptions="CenterAndExpand" />
                                                                        </Frame>
                                                                        <StackLayout Style="{StaticResource detailsStackLayout}">
                                                                            <Label Style="{StaticResource NameLabel}" Text="{Binding FriendName}" />
                                                                            <StackLayout Style="{StaticResource imageLableStackLayout}">
                                                                                <Label Style="{StaticResource TitleLabelStyle}" Text="{Binding TitleDesc}" />
                                                                            </StackLayout>
                                                                            <StackLayout Style="{StaticResource imageLableStackLayout}">
                                                                                <Label
                                                                                    FontAttributes="Bold"
                                                                                    Style="{StaticResource LabelStyle}"
                                                                                    Text="Tap here to view profile..."
                                                                                    TextColor="Blue">
                                                                                    <Label.GestureRecognizers>
                                                                                        <TapGestureRecognizer Buttons="Primary" 
                                                                                        CommandParameter="{Binding .}"    
                                                                                        Tapped="OnTapGestureRecognizerTapped" />
                                                                                    </Label.GestureRecognizers>
                                                                                </Label>
                                                                            </StackLayout>
                                                                            <StackLayout Style="{StaticResource imageLableStackLayout}">
                                                                                <Label Style="{StaticResource LabelStyle}" Text="Swipe right to drop contact..." />
                                                                            </StackLayout>
                                                                        </StackLayout>
                                                                    </StackLayout>
                                                                </StackLayout>
                                                            </Frame>
                                                        </StackLayout>
                                                    </SwipeView>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </StackLayout>
                                </RefreshView.Content>
                            </RefreshView>

                        </Grid>

                    </sfToolkit:SfTabItem.Content>

                </sfToolkit:SfTabItem>

                <sfToolkit:SfTabItem Header="Requests">
                    <sfToolkit:SfTabItem.Content>
                        <!--  Grid BackgroundColor="WhiteSmoke"  -->

                        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
                            <RefreshView.Content>
                                <StackLayout>

                                    <CollectionView
                                        x:Name="conReqView"
                                        ItemsSource="{Binding ContactRequest}"
                                        SelectionMode="Single">

                                        <CollectionView.EmptyView>
                                            <Label Padding="10" Text="You have no contact requests." />
                                        </CollectionView.EmptyView>

                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <SwipeView BackgroundColor="White">
                                                    <SwipeView.LeftItems>
                                                        <SwipeItems>
                                                            <SwipeItem
                                                                BackgroundColor="Green"
                                                                Command="{Binding Source={x:Reference conReqView}, Path=BindingContext.AcceptCommand}"
                                                                CommandParameter="{Binding .}"
                                                                Text="Accept" />
                                                            <SwipeItem
                                                                BackgroundColor="Red"
                                                                Command="{Binding Source={x:Reference conReqView}, Path=BindingContext.RejectCommand}"
                                                                CommandParameter="{Binding .}"
                                                                Text="Reject" />
                                                        </SwipeItems>
                                                    </SwipeView.LeftItems>

                                                    <StackLayout Padding="10,10,10,0" Spacing="8">
                                                        <Frame>
                                                            <StackLayout>
                                                                <StackLayout Padding="0,0,0,10" Style="{StaticResource itemsInsideCardViewStackLayoutStyle}">
                                                                    <Frame Style="{StaticResource profileImageFrameStyle}">
                                                                        <Image
                                                                            Aspect="AspectFill"
                                                                            HeightRequest="88"
                                                                            HorizontalOptions="StartAndExpand"
                                                                            Source="{Binding PicturePath}"
                                                                            Style="{StaticResource profileImageStyle}"
                                                                            VerticalOptions="CenterAndExpand" />
                                                                    </Frame>
                                                                    <StackLayout Style="{StaticResource detailsStackLayout}">
                                                                        <Label Style="{StaticResource NameLabel}" Text="{Binding FriendName}" />
                                                                        <StackLayout Style="{StaticResource imageLableStackLayout}">
                                                                            <Label Style="{StaticResource TitleLabelStyle}" Text="{Binding TitleDesc}" />
                                                                        </StackLayout>
                                                                        <StackLayout Style="{StaticResource imageLableStackLayout}">
                                                                            <Label
                                                                                FontAttributes="Bold"
                                                                                Style="{StaticResource LabelStyle}"
                                                                                Text="Tap here to view profile..."
                                                                                TextColor="Blue">
                                                                                <Label.GestureRecognizers>
                                                                                    <TapGestureRecognizer
                                                                                        Buttons="Secondary"
                                                                                        CommandParameter="{Binding .}" 
                                                                                        Tapped="OnTapGestureRecognizerTapped" />
                                                                                </Label.GestureRecognizers>
                                                                            </Label>
                                                                        </StackLayout>
                                                                        <StackLayout Style="{StaticResource imageLableStackLayout}">
                                                                            <Label Style="{StaticResource LabelStyle}" Text="Swipe right to accept or reject request..." />
                                                                        </StackLayout>
                                                                    </StackLayout>
                                                                </StackLayout>
                                                            </StackLayout>
                                                        </Frame>
                                                    </StackLayout>
                                                </SwipeView>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>

                                </StackLayout>
                            </RefreshView.Content>
                        </RefreshView>

                        <!--  /Grid  -->
                    </sfToolkit:SfTabItem.Content>
                </sfToolkit:SfTabItem>

            </sfToolkit:SfTabView.Items>

        </sfToolkit:SfTabView>

    </ContentPage.Content>

</ContentPage>