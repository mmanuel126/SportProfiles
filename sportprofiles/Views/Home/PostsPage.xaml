<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="sportprofiles.Views.Home.PostsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:data="clr-namespace:sportprofiles.Models"
    xmlns:helper="clr-namespace:sportprofiles.Helper"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:local="clr-namespace:sportprofiles.ViewModels"
    xmlns:sfTreeView="clr-namespace:Syncfusion.Maui.TreeView;assembly=Syncfusion.Maui.TreeView"
    xmlns:treeviewengine1="clr-namespace:Syncfusion.TreeView.Engine;assembly=Syncfusion.Maui.TreeView"
    Title="Posts">

    <ContentPage.BindingContext>
        <local:PostsViewModel />
    </ContentPage.BindingContext>

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding RefreshCommand}" IconImageSource="refresh.png" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <Style Class="TextColor" TargetType="Label">
            <Setter Property="TextColor" Value="Blue" />
        </Style>

        <ResourceDictionary>
            <helper:RepliesTextConverter x:Key="RepliesTextConverter" />
            <helper:RepliesCountConverter x:Key="RepliesCountConverter" />
            <helper:DateConverter x:Key="DateConverter" />

            <Style x:Key="NameLabel" TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="HorizontalTextAlignment" Value="Start" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="Black" />
            </Style>

            <Style x:Key="profileImageStyle" TargetType="Image">
                <Setter Property="WidthRequest" Value="80" />
                <Setter Property="HeightRequest" Value="60" />
                <Setter Property="Aspect" Value="AspectFit" />
            </Style>

            <Style x:Key="profileImageFrameStyle" TargetType="Frame">
                <Setter Property="CornerRadius" Value="40" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="IsClippedToBounds" Value="True" />
            </Style>

            <Style x:Key="detailsStackLayout" TargetType="StackLayout">
                <Setter Property="HorizontalOptions" Value="FillAndExpand" />
                <Setter Property="VerticalOptions" Value="FillAndExpand" />
                <Setter Property="Spacing" Value="2" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">

        <AbsoluteLayout>

            <StackLayout
                Padding="0,13,0,0"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                HorizontalOptions="CenterAndExpand"
                Orientation="Vertical">

                <Grid
                    BackgroundColor="WhiteSmoke"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.BindingContext>
                            <local:PostsViewModel />
                        </Grid.BindingContext>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackLayout Grid.Row="0">
                            <inputLayout:SfTextInputLayout
                                Grid.Row="0"
                                Margin="10"
                                Padding="0,0,0,0"
                                BackgroundColor="White"
                                ContainerBackground="White"
                                ContainerType="Outlined"
                                Hint="Start a new conversation..."
                                OutlineCornerRadius="22"
                                ReserveSpaceForAssistiveLabels="False"
                                TrailingViewPosition="Inside">
                                <Entry
                                    Margin="10"
                                    BackgroundColor="White"
                                    FontSize="13"
                                    HeightRequest="25"
                                    Placeholder=""
                                    PlaceholderColor="Black"
                                    Text="{Binding ConversationMessage}" />
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image
                                        x:Name="sendimagename"
                                        Margin="10"
                                        HeightRequest="20"
                                        WidthRequest="20">
                                        <Image.Source>
                                            <FileImageSource File="send.png" />
                                        </Image.Source>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NewConversationCommand}" CommandParameter="{Binding .}" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </inputLayout:SfTextInputLayout.TrailingView>

                            </inputLayout:SfTextInputLayout>

                            <BoxView
                                Grid.Row="0"
                                BackgroundColor="#E4E4E4"
                                HeightRequest="1" />

                            <sfTreeView:SfTreeView
                                x:Name="treeView"
                                AutoExpandMode="AllNodesExpanded"
                                ExpanderWidth="0"
                                Indentation="52"
                                ItemTemplateContextType="Node"
                                ItemsSource="{Binding Conversations}"
                                NotificationSubscriptionMode="CollectionChange"
                                QueryNodeSize="treeView_QueryNodeSize"
                                SelectionMode="None">
                                <sfTreeView:SfTreeView.ItemTemplate>
                                    <helper:ItemTemplateSelector>
                                        <helper:ItemTemplateSelector.ConversationTemplate>
                                            <DataTemplate>
                                                <Grid Padding="2,1,0,1">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.Resources />
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackLayout Padding="3,17">
                                                        <Frame
                                                            Padding="2"
                                                            CornerRadius="20"
                                                            IsClippedToBounds="true">
                                                            <Image
                                                                HeightRequest="40"
                                                                HorizontalOptions="Center"
                                                                Source="{Binding Content.ProfileIcon}"
                                                                VerticalOptions="Start"
                                                                WidthRequest="40" />
                                                        </Frame>

                                                    </StackLayout>

                                                    <StackLayout Grid.Column="1" Style="{StaticResource detailsStackLayout}">
                                                        <Frame
                                                            Margin="0,8,8,0"
                                                            Padding="8"
                                                            BackgroundColor="#f7f9fa"
                                                            BorderColor="#E4E4E4"
                                                            CornerRadius="20"
                                                            HasShadow="False">
                                                            <Grid ColumnSpacing="0" RowSpacing="0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Label
                                                                    Grid.Row="0"
                                                                    Grid.Column="0"
                                                                    Padding="10"
                                                                    FontAttributes="Bold"
                                                                    FontSize="13"
                                                                    Text="{Binding Content.Name}"
                                                                    TextColor="{Binding Content.TextColor}"
                                                                    VerticalOptions="Start"
                                                                    WidthRequest="120" />

                                                                <Label
                                                                    Grid.Row="1"
                                                                    Margin="0,-11,0,0"
                                                                    FontSize="14"
                                                                    Text="{Binding Content.Message}"
                                                                    TextColor="#212121"
                                                                    VerticalOptions="Start" />
                                                            </Grid>
                                                        </Frame>
                                                        <Grid Padding="5,5,15,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="20" />
                                                            </Grid.RowDefinitions>
                                                            <Label
                                                                Grid.Column="0"
                                                                FontAttributes="None"
                                                                FontSize="12"
                                                                Text="{Binding Content.Date}"
                                                                TextColor="#757575"
                                                                VerticalOptions="Start" />
                                                            <Grid Grid.Column="1" HorizontalOptions="End">

                                                                <Image
                                                                    Grid.Column="0"
                                                                    HeightRequest="18"
                                                                    HorizontalOptions="End"
                                                                    VerticalOptions="Center"
                                                                    WidthRequest="18">
                                                                    <Image.Source>
                                                                        <FileImageSource File="reply.png" />
                                                                    </Image.Source>
                                                                </Image>
                                                                <Label
                                                                    Grid.Column="1"
                                                                    FontSize="12"
                                                                    Text="Reply"
                                                                    TextColor="#757575"
                                                                    VerticalOptions="Center" />
                                                                <Grid.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.ReplyEditCommand, Source={x:Reference treeView}}" CommandParameter="{Binding .}" />
                                                                </Grid.GestureRecognizers>
                                                            </Grid>
                                                        </Grid>
                                                        <Grid
                                                            x:Name="replyGrid"
                                                            Padding="5,2,0,0"
                                                            ColumnSpacing="0"
                                                            IsVisible="{Binding Content.IsNeedExpand}"
                                                            RowSpacing="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label
                                                                Grid.Column="0"
                                                                FontAttributes="Bold"
                                                                FontSize="12"
                                                                Text="{Binding IsExpanded, Converter={StaticResource RepliesTextConverter}}"
                                                                TextColor="#212121"
                                                                VerticalOptions="Fill" />
                                                            <Label
                                                                Grid.Column="1"
                                                                FontAttributes="Bold"
                                                                FontSize="12"
                                                                Text="{Binding Content.Replies, Converter={StaticResource RepliesCountConverter}}"
                                                                TextColor="#212121"
                                                                VerticalOptions="Fill" />
                                                            <Grid.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Path=BindingContext.ExpandActionCommand, Source={x:Reference treeView}}" CommandParameter="{Binding .}" />
                                                            </Grid.GestureRecognizers>
                                                        </Grid>
                                                        <inputLayout:SfTextInputLayout
                                                            Margin="0,0,8,0"
                                                            BackgroundColor="Transparent"
                                                            ContainerType="Outlined"
                                                            IsVisible="{Binding Content.IsInEditMode}"
                                                            OutlineCornerRadius="22"
                                                            ReserveSpaceForAssistiveLabels="False"
                                                            TrailingViewPosition="Inside">
                                                            <Entry
                                                                x:Name="conversationEntry"
                                                                FontSize="12"
                                                                Placeholder="Enter the reply"
                                                                Text="{Binding Content.ReplyMessage}">
                                                                <Entry.Triggers>
                                                                    <DataTrigger
                                                                        Binding="{Binding Content.IsInEditMode}"
                                                                        TargetType="Entry"
                                                                        Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <helper:FocusTriggerAction />
                                                                        </DataTrigger.EnterActions>
                                                                    </DataTrigger>
                                                                </Entry.Triggers>
                                                            </Entry>
                                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                                <Image
                                                                    x:Name="sendimagename"
                                                                    HeightRequest="28"
                                                                    WidthRequest="28">
                                                                    <Image.Source>
                                                                        <FileImageSource File="send.png" />
                                                                    </Image.Source>
                                                                    <Image.GestureRecognizers>
                                                                        <TapGestureRecognizer Command="{Binding Path=BindingContext.NewReplyCommand, Source={x:Reference treeView}}" CommandParameter="{Binding .}" />
                                                                    </Image.GestureRecognizers>
                                                                </Image>
                                                            </inputLayout:SfTextInputLayout.TrailingView>
                                                        </inputLayout:SfTextInputLayout>
                                                    </StackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </helper:ItemTemplateSelector.ConversationTemplate>
                                        <helper:ItemTemplateSelector.ReplyTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0,1,0,1">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackLayout Padding="3,17">
                                                        <Frame
                                                            Padding="2"
                                                            CornerRadius="20"
                                                            IsClippedToBounds="True">
                                                            <Image
                                                                HeightRequest="40"
                                                                HorizontalOptions="Center"
                                                                Source="{Binding Content.ProfileIcon}"
                                                                VerticalOptions="Start"
                                                                WidthRequest="40" />
                                                        </Frame>
                                                    </StackLayout>

                                                    <StackLayout Grid.Column="1">
                                                        <Frame
                                                            Margin="0,8,8,0"
                                                            Padding="8"
                                                            BackgroundColor="#f7f9fa"
                                                            BorderColor="#E4E4E4"
                                                            CornerRadius="20"
                                                            HasShadow="False">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <HorizontalStackLayout>
                                                                    <Label
                                                                        Grid.Row="0"
                                                                        Grid.Column="0"
                                                                        Margin="0,3,0,0"
                                                                        FontAttributes="Bold"
                                                                        FontSize="13"
                                                                        Text="{Binding Content.Name}"
                                                                        TextColor="{Binding Content.TextColor}"
                                                                        VerticalOptions="Start"
                                                                        WidthRequest="250" />
                                                                </HorizontalStackLayout>
                                                                <Label
                                                                    Grid.Row="1"
                                                                    Margin="0,2,0,0"
                                                                    FontSize="14"
                                                                    Text="{Binding Content.Message}"
                                                                    TextColor="#212121" />
                                                            </Grid>
                                                        </Frame>
                                                        <Grid Padding="5,5,15,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="20" />
                                                            </Grid.RowDefinitions>
                                                            <Label
                                                                Grid.Column="0"
                                                                FontAttributes="None"
                                                                FontSize="12"
                                                                Text="{Binding Content.Date}"
                                                                TextColor="#757575"
                                                                VerticalOptions="Start" />
                                                        </Grid>
                                                        <inputLayout:SfTextInputLayout
                                                            Margin="0"
                                                            Padding="0"
                                                            BackgroundColor="Transparent"
                                                            ContainerBackground="White"
                                                            ContainerType="Outlined"
                                                            Hint="Write a comment..."
                                                            IsVisible="true"
                                                            OutlineCornerRadius="22"
                                                            ReserveSpaceForAssistiveLabels="False"
                                                            TrailingViewPosition="Inside">
                                                            <Entry
                                                                Margin="5"
                                                                FontSize="12"
                                                                HeightRequest="13"
                                                                Placeholder="Write a comment"
                                                                Text="{Binding Content.ReplyMessage}">
                                                                <Entry.Triggers>
                                                                    <DataTrigger
                                                                        Binding="{Binding Content.IsInEditMode}"
                                                                        TargetType="Entry"
                                                                        Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <helper:FocusTriggerAction />
                                                                        </DataTrigger.EnterActions>
                                                                    </DataTrigger>
                                                                </Entry.Triggers>
                                                            </Entry>
                                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                                <Image
                                                                    x:Name="sendimagename1"
                                                                    HeightRequest="25"
                                                                    WidthRequest="25">
                                                                    <Image.Source>
                                                                        <FileImageSource File="send.png" />
                                                                    </Image.Source>
                                                                    <Image.GestureRecognizers>
                                                                        <TapGestureRecognizer Command="{Binding Path=BindingContext.NewReplyCommand, Source={x:Reference treeView}}" CommandParameter="{Binding .}" />
                                                                    </Image.GestureRecognizers>
                                                                </Image>
                                                            </inputLayout:SfTextInputLayout.TrailingView>
                                                        </inputLayout:SfTextInputLayout>
                                                    </StackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </helper:ItemTemplateSelector.ReplyTemplate>
                                    </helper:ItemTemplateSelector>
                                </sfTreeView:SfTreeView.ItemTemplate>
                                <sfTreeView:SfTreeView.Behaviors>
                                    <helper:AutoFitTreeViewBehavior />
                                </sfTreeView:SfTreeView.Behaviors>
                                <sfTreeView:SfTreeView.HierarchyPropertyDescriptors>
                                    <treeviewengine1:HierarchyPropertyDescriptor ChildPropertyName="Replies" TargetType="{x:Type data:Conversation}" />
                                </sfTreeView:SfTreeView.HierarchyPropertyDescriptors>
                            </sfTreeView:SfTreeView>

                        </StackLayout>
                    </Grid>
                </Grid>
            </StackLayout>

            <StackLayout
                x:Name="aiLayout"
                Padding="0,70,0,0"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                BackgroundColor="WhiteSmoke"
                IsVisible="{Binding IsRefreshing}"
                Opacity="1.9">
                <ActivityIndicator
                    x:Name="ai"
                    HorizontalOptions="CenterAndExpand"
                    IsRunning="{Binding IsRefreshing}"
                    VerticalOptions="Center"
                    Color="Black" />
                <Label
                    HorizontalOptions="Center"
                    Text="Checking for new posts..."
                    TextColor="Black"
                    VerticalOptions="Center" />
            </StackLayout>

        </AbsoluteLayout>

    </RefreshView>

</ContentPage>