<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="sportprofiles.Controls.FlyoutFooter"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    HeightRequest="140">

    <Grid Padding="0,0,0,0" BackgroundColor="#f7f9fa">

        <StackLayout Margin="0,28,0,0">
            <Image
                x:Name="imgLogo"
                HeightRequest="40"
                HorizontalOptions="Center"
                Source="logo.jpg"
                VerticalOptions="Center"
                WidthRequest="120" />
            <Label
                FontAttributes="Bold"
                FontSize="14"
                HorizontalTextAlignment="Center"
                Text="A sport social networking site for athletes, agents, and fanatics to connect."
                TextColor="Gray"
                VerticalTextAlignment="Center" />
        </StackLayout>
    </Grid>

</ContentView>